# Model weights (never committed)
/models/
*.pt
*.bin
*.safetensors
*.onnx
*.ckpt
*.pth

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Bulky audio binaries only; keep .lrc / .ref.json / result JSON as evidence.
/benchmarks/**/*.wav
/benchmarks/**/*.mp3
/benchmarks/**/*.flac
/benchmarks/**/*.m4a
/experiments/audio/*.wav
/experiments/audio/*.flac
/experiments/audio/*.mp3
/experiments/audio/*.m4a

# GTSinger raw audio + per-segment annotations + derived eval sets are NOT
# redistributable at will (CC BY-NC-SA 4.0; lyrics are third-party copyright).
# Only the generated *report* JSON under experiments/reports/ is committed.
/experiments/singing/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Derived diagnostic arrays (never commit)
*.npz
*.npy

# Android ONNX export deliverables: the .onnx weights and test audio are kept on
# disk and transferred to MeloX-Android by hand; the concrete rules are at the end
# of this file (scripts / manifests / reports are committed).

# Local real-song test material (third-party audio/lyrics; NEVER commit)
/Test/

# Human annotation working files (contain third-party lyrics; NEVER commit)
/experiments/annotation/

# Full per-song alignment results contain third-party lyrics; NEVER commit
/experiments/reports/fullsong_*.json
/experiments/amll_reference/
/experiments/amll_results/

# Android ONNX delivery (android_export/): weights, test audio and scratch caches
# must never be committed (the scratch dir can contain third-party lyric text);
# the exporter scripts, manifests and REPORT.md are our own work and may be.
/android_export/**/*.onnx
/android_export/**/test_vectors/
/android_export/**/_work/
/android_export/**/__pycache__/

# V1.1 playlist dataset (per-file paths; only the aggregate report is committed)
/experiments/playlist/
